@model PhotoSpotOman.Models.Spot
@{
    ViewData["Title"] = Model.Name + " - PhotoSpot Oman";
    var userLiked = ViewBag.UserLiked as bool? ?? false;
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}
@Html.AntiForgeryToken()

<div class="spot-details-page">
    <div class="container py-5">
        <!-- Spot Header -->
        <div class="spot-header mb-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h1 class="spot-title">@Model.Name</h1>
                    <div class="spot-meta">
                        <span><i class='bx bx-user'></i> @Model.User?.Name</span>
                        <span><i class='bx bx-category'></i> @Model.Category?.Name</span>
                        <span><i class='bx bx-map'></i> @Model.Region</span>
                        <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
                    </div>
                </div>
                @if (isAuthenticated)
                {
                    <div class="spot-actions">
                        <button id="likeBtn" class="btn btn-like @(userLiked ? "liked" : "")" data-spot-id="@Model.Id">
                            <i class='bx @(userLiked ? "bxs" : "bx")-heart'></i>
                            <span id="likeCount">@(Model.Likes?.Count ?? 0)</span>
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Image Gallery -->
                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="image-gallery mb-4">
                        <div class="main-image">
                            <img id="mainImage" src="@Model.Images.First().ImagePath" alt="@Model.Name" />
                        </div>
                        @if (Model.Images.Count > 1)
                        {
                            <div class="thumbnail-images">
                                @foreach (var image in Model.Images)
                                {
                                    <img src="@image.ImagePath" alt="Thumbnail" class="thumbnail @(image == Model.Images.First() ? "active" : "")" onclick="changeMainImage('@image.ImagePath')" />
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Description -->
                <div class="content-card mb-4">
                    <h3 class="section-title">
                        <i class='bx bx-text'></i> Description
                    </h3>
                    <p class="spot-description">@Model.Description</p>
                </div>

                <!-- Map -->
                <div class="content-card mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="section-title mb-0">
                            <i class='bx bx-map'></i> Location
                        </h3>
                        <a href="https://www.google.com/maps/dir/?api=1&destination=@Model.Latitude,@Model.Longitude" target="_blank" class="btn btn-primary-custom">
                            <i class='bx bx-navigation'></i> Get Directions
                        </a>
                    </div>
                    <div id="map" style="height: 400px; border-radius: 12px; overflow: hidden;"></div>
                    <div class="location-info mt-3">
                        <p><strong>Coordinates:</strong> @Model.Latitude.ToString("F6"), @Model.Longitude.ToString("F6")</p>
                        @if (!string.IsNullOrEmpty(Model.LocationName))
                        {
                            <p><strong>Address:</strong> @Model.LocationName</p>
                        }
                    </div>
                </div>

                <!-- Comments Section -->
                <div class="content-card">
                    <h3 class="section-title">
                        <i class='bx bx-comment'></i> Comments (@(Model.Comments?.Count ?? 0))
                    </h3>

                    @if (isAuthenticated)
                    {
                        <div class="comment-form mb-4">
                            <textarea id="commentInput" class="form-control-custom" rows="3" placeholder="Write a comment..."></textarea>
                            <button id="submitComment" class="btn btn-primary-custom mt-2" data-spot-id="@Model.Id">
                                <i class='bx bx-send'></i> Post Comment
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert-info mb-4">
                            <i class='bx bx-info-circle'></i> Please <a asp-controller="Login" asp-action="Index">login</a> to comment.
                        </div>
                    }

                    <div id="commentsContainer">
                        @if (Model.Comments != null && Model.Comments.Any())
                        {
                            @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                            {
                                <div class="comment-item" data-comment-id="@comment.Id">
                                    <div class="comment-header">
                                        <strong>@comment.User?.Name</strong>
                                        <span class="comment-date">@comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                        @if (isAuthenticated && (User.IsInRole("Admin") || (User.Identity != null && comment.UserId == int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "0"))))
                                        {
                                            <button class="delete-comment-btn" data-comment-id="@comment.Id">
                                                <i class='bx bx-trash'></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="comment-content">@comment.Content</div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No comments yet. Be the first to comment!</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="sidebar-card">
                    <h4 class="sidebar-title">Spot Information</h4>
                    <div class="info-item">
                        <i class='bx bx-user'></i>
                        <div>
                            <strong>Added By</strong>
                            <p>@Model.User?.Name</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <i class='bx bx-category'></i>
                        <div>
                            <strong>Category</strong>
                            <p>@(Model.Category?.Name ?? "Uncategorized")</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <i class='bx bx-map'></i>
                        <div>
                            <strong>Region</strong>
                            <p>@(Model.Region ?? "Not specified")</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <i class='bx bx-heart'></i>
                        <div>
                            <strong>Likes</strong>
                            <p id="sidebarLikeCount">@(Model.Likes?.Count ?? 0)</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <i class='bx bx-comment'></i>
                        <div>
                            <strong>Comments</strong>
                            <p>@(Model.Comments?.Count ?? 0)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Initialize map
        var map = L.map('map').setView([@Model.Latitude, @Model.Longitude], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(map);

        L.marker([@Model.Latitude, @Model.Longitude])
            .addTo(map)
            .bindPopup('@Model.Name')
            .openPopup();

        // Image gallery
        function changeMainImage(imagePath) {
            document.getElementById('mainImage').src = imagePath;
            document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
        }

        // Like functionality
        @if (isAuthenticated)
        {
            <text>
            document.getElementById('likeBtn').addEventListener('click', function() {
                var spotId = this.getAttribute('data-spot-id');
                var btn = this;
                var icon = btn.querySelector('i');
                var countSpan = document.getElementById('likeCount');
                var sidebarCount = document.getElementById('sidebarLikeCount');

                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                fetch('/Like/Toggle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `spotId=${spotId}&__RequestVerificationToken=${encodeURIComponent(token)}`
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        if (data.liked) {
                            btn.classList.add('liked');
                            icon.classList.remove('bx-heart');
                            icon.classList.add('bxs-heart');
                        } else {
                            btn.classList.remove('liked');
                            icon.classList.remove('bxs-heart');
                            icon.classList.add('bx-heart');
                        }
                        countSpan.textContent = data.count;
                        sidebarCount.textContent = data.count;
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: data.message || 'An error occurred. Please try again.',
                            icon: 'error',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        title: 'Error',
                        text: 'An error occurred. Please try again.',
                        icon: 'error',
                        customClass: { confirmButton: 'btn btn-primary' },
                        buttonsStyling: false
                    });
                });
            });
            </text>
        }

        // Comment functionality
        @if (isAuthenticated)
        {
            <text>
            document.getElementById('submitComment').addEventListener('click', function() {
                var spotId = this.getAttribute('data-spot-id');
                var content = document.getElementById('commentInput').value.trim();

                if (!content) {
                    Swal.fire({
                        title: 'Empty Comment',
                        text: 'Please write a comment before posting.',
                        icon: 'warning',
                        customClass: { confirmButton: 'btn btn-primary' },
                        buttonsStyling: false
                    });
                    return;
                }

                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                fetch('/Comment/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `spotId=${spotId}&content=${encodeURIComponent(content)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(text || 'Network response was not ok');
                        });
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        document.getElementById('commentInput').value = '';
                        
                        // Add comment to container
                        var commentsContainer = document.getElementById('commentsContainer');
                        // Remove "No comments yet" message if it exists
                        var noCommentsMsg = commentsContainer.querySelector('p.text-muted');
                        if (noCommentsMsg) {
                            noCommentsMsg.remove();
                        }
                        
                        var commentHtml = `
                            <div class="comment-item" data-comment-id="${data.comment.id}">
                                <div class="comment-header">
                                    <strong>${data.comment.userName}</strong>
                                    <span class="comment-date">${data.comment.createdAt}</span>
                                    <button class="delete-comment-btn" data-comment-id="${data.comment.id}">
                                        <i class='bx bx-trash'></i>
                                    </button>
                                </div>
                                <div class="comment-content">${data.comment.content}</div>
                            </div>
                        `;
                        commentsContainer.insertAdjacentHTML('afterbegin', commentHtml);
                        
                        // Attach delete handler
                        var deleteBtn = commentsContainer.querySelector(`[data-comment-id="${data.comment.id}"] .delete-comment-btn`);
                        if (deleteBtn) {
                            deleteBtn.addEventListener('click', handleDeleteComment);
                        }
                    } else {
                        Swal.fire({
                            title: 'Error',
                            text: data.message || 'An error occurred while adding the comment.',
                            icon: 'error',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        title: 'Error',
                        text: error.message || 'An error occurred. Please try again.',
                        icon: 'error',
                        customClass: { confirmButton: 'btn btn-primary' },
                        buttonsStyling: false
                    });
                });
            });

            // Delete comment
            function handleDeleteComment() {
                var commentId = this.getAttribute('data-comment-id');
                var commentItem = document.querySelector(`[data-comment-id="${commentId}"]`);

                Swal.fire({
                    title: 'Delete Comment?',
                    text: 'Are you sure you want to delete this comment?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'btn btn-primary',
                        cancelButton: 'btn btn-secondary-custom'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                        fetch('/Comment/Delete', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': token
                            },
                            body: `id=${commentId}&__RequestVerificationToken=${encodeURIComponent(token)}`
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                commentItem.remove();
                            } else {
                                Swal.fire({
                                    title: 'Error',
                                    text: data.message,
                                    icon: 'error',
                                    customClass: { confirmButton: 'btn btn-primary' },
                                    buttonsStyling: false
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire({
                                title: 'Error',
                                text: 'An error occurred. Please try again.',
                                icon: 'error',
                                customClass: { confirmButton: 'btn btn-primary' },
                                buttonsStyling: false
                            });
                        });
                    }
                });
            }

            // Attach delete handlers to existing comments
            document.querySelectorAll('.delete-comment-btn').forEach(btn => {
                btn.addEventListener('click', handleDeleteComment);
            });
            </text>
        }
    </script>
}

