@{
    ViewData["Title"] = "Access Forbidden - PhotoSpot Oman";
}

<div class="spots-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <div class="form-card">
                    <div class="mb-4">
                        <i class='bx bx-error-circle' style="font-size: 120px; color: #ef4444; margin-bottom: 20px;"></i>
                    </div>
                    <h1 class="page-title">403 - Access Forbidden</h1>
                    <p class="page-subtitle mb-4">
                        You don't have permission to access this resource.
                    </p>
                    <p class="text-muted mb-4">
                        If you believe this is an error, please contact the administrator or try logging in with a different account.
                    </p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom">
                            <i class='bx bx-home'></i> Go to Home
                        </a>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Spot" asp-action="Index" class="btn btn-secondary-custom">
                                <i class='bx bx-map'></i> Browse Spots
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Login" asp-action="Index" class="btn btn-secondary-custom">
                                <i class='bx bx-log-in'></i> Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


