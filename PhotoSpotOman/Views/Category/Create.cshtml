@model PhotoSpotOman.Models.Category
@{
    ViewData["Title"] = "Create Category - PhotoSpot Oman";
}

<div class="create-spot-page">
    <div class="container py-5">
        <div class="page-header mb-4">
            <h1 class="page-title">Create Category</h1>
            <p class="page-subtitle">Add a new category for organizing spots</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="form-card">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group">
                            <label asp-for="Name" class="form-label">
                                <i class='bx bx-rename'></i> Category Name *
                            </label>
                            <input asp-for="Name" class="form-control-custom" placeholder="e.g., Beaches, Mountains" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="form-label">
                                <i class='bx bx-text'></i> Description
                            </label>
                            <textarea asp-for="Description" class="form-control-custom" rows="4" placeholder="Optional description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary-custom">
                                <i class='bx bx-check'></i> Create Category
                            </button>
                            <a asp-action="Index" class="btn btn-secondary-custom">
                                <i class='bx bx-x'></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


