  <diagram id="user-flow" name="User Authentication Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Title -->
        <mxCell id="title3" value="User Authentication Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Start -->
        <mxCell id="start" value="User Visits&#xa;PhotoSpotOman" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Decision: Authenticated? -->
        <mxCell id="auth-check" value="Is User&#xa;Authenticated?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="160" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Login Page -->
        <mxCell id="login-page" value="Login Page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Home Page -->
        <mxCell id="home-page" value="Home Page&#xa;(Full Access)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="280" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Sign Up Flow -->
        <mxCell id="signup-box" value="SIGN UP" style="swimlane;startSize=25;fillColor=#e3f2fd;strokeColor=#1976d2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="280" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="fill-form" value="Fill Registration Form&#xa;(Name, Email, Password)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;" vertex="1" parent="signup-box">
          <mxGeometry x="50" y="40" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="validate" value="Valid Input?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;" vertex="1" parent="signup-box">
          <mxGeometry x="80" y="110" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="email-check" value="Email&#xa;Exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;" vertex="1" parent="signup-box">
          <mxGeometry x="80" y="180" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="hash-pwd" value="Hash Password&#xa;Create User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;" vertex="1" parent="signup-box">
          <mxGeometry x="70" y="250" width="140" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Sign In Flow -->
        <mxCell id="signin-box" value="SIGN IN" style="swimlane;startSize=25;fillColor=#fce4ec;strokeColor=#c2185b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="380" width="280" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="enter-creds" value="Enter Email &amp; Password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd9;strokeColor=#c2185b;" vertex="1" parent="signin-box">
          <mxGeometry x="50" y="40" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="user-found" value="User&#xa;Found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;" vertex="1" parent="signin-box">
          <mxGeometry x="80" y="100" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pwd-valid" value="Password&#xa;Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;" vertex="1" parent="signin-box">
          <mxGeometry x="80" y="170" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="create-claims" value="Create Claims Identity&#xa;Set Auth Cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;" vertex="1" parent="signin-box">
          <mxGeometry x="50" y="240" width="180" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Error Messages -->
        <mxCell id="error-box" value="Error Messages" style="swimlane;startSize=25;fillColor=#ffcdd2;strokeColor=#e53935;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="200" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="err1" value="❌ Invalid Input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;" vertex="1" parent="error-box">
          <mxGeometry x="30" y="35" width="140" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="err2" value="❌ Email Already Exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;" vertex="1" parent="error-box">
          <mxGeometry x="30" y="75" width="140" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="err3" value="❌ Account Not Found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;" vertex="1" parent="error-box">
          <mxGeometry x="30" y="115" width="140" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="err4" value="❌ Invalid Password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;" vertex="1" parent="error-box">
          <mxGeometry x="30" y="145" width="140" height="30" as="geometry"/>
        </mxCell>
        
        <!-- Success -->
        <mxCell id="success" value="✓ Success!&#xa;Redirect to Home" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="740" width="140" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="a1" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="auth-check">
          <mxGeometry width="50" height="50" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="No" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="auth-check" target="login-page">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a3" value="Yes" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="auth-check" target="home-page">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1020" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a4" value="" style="endArrow=classic;html=1;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="login-page" target="signup-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="350"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a5" value="" style="endArrow=classic;html=1;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="login-page" target="signin-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="350"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a6" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="create-claims" target="success">
          <mxGeometry width="50" height="50" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a7" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hash-pwd" target="success">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="710"/>
              <mxPoint x="570" y="710"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
  
  <diagram id="spot-workflow" name="Spot Management Workflow">
